<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/forecast_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_report_image"
        android:contentDescription="Forecast Condition Icon" />

    <TextView
        android:id="@+id/forecast_text_condition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:text="Condition"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/forecast_text_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi: 00°F"
        android:textColor="#FF5555"
        android:textSize="14sp"
        android:paddingEnd="8dp" />

    <TextView
        android:id="@+id/forecast_text_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lo: 00°F"
        android:textColor="#5555FF"
        android:textSize="14sp" />

</LinearLayout>