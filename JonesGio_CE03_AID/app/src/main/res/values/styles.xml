<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LastNameFirstName_CE03" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="FrameBase">
        <item name="android:background">@color/bg_red</item>
    </style>

    <style name="FrameStyle.Portrait" parent="FrameBase">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">200dp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <style name="FrameStyle.Landscape" parent="FrameBase">
        <item name="android:layout_width">275dp</item>
        <item name="android:layout_height">275dp</item>
        <item name="android:layout_gravity">left|center_vertical</item>
        <item name="android:layout_marginLeft">16dp</item>
    </style>

    <style name="DisplayStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:layout_gravity">top|center_horizontal</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="DisplayStyle.Black">
        <item name="android:textColor">@color/text_black</item>
    </style>

    <style name="DisplayStyle.Grey">
        <item name="android:textColor">@color/text_grey</item>
    </style>

    <style name="DisplayStyle.White">
        <item name="android:textColor">@color/text_white</item>
    </style>

    <style name="DisplayStyle.Normal">
        <item name="android:textStyle">normal</item>
    </style>

    <style name="DisplayStyle.Bold">
        <item name="android:textStyle">bold</item>
    </style>
</resources>