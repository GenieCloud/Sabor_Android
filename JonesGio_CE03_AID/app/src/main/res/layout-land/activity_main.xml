<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/frameLayout_display"
            style="@style/FrameStyle.Landscape">

            <ImageView
                android:id="@+id/imageView_icon"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="@string/icon" />

            <TextView
                android:id="@+id/textView_display"
                style="@style/DisplayStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="24dp">

            <TextView
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/background_color" />

            <RadioGroup
                android:id="@+id/radioGroup_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rb_bg_red" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/red" android:checked="true" />
                <RadioButton android:id="@+id/rb_bg_blue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/blue" />
                <RadioButton android:id="@+id/rb_bg_green" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/green" />
            </RadioGroup>

            <EditText
                android:id="@+id/editText_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enter_text_here"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName" />

            <TextView
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_color" />

            <RadioGroup
                android:id="@+id/radioGroup_textColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_text_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/black" />

                <RadioButton
                    android:id="@+id/rb_text_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grey" />

                <RadioButton
                    android:id="@+id/rb_text_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/white" />
            </RadioGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_bold"
                style="@style/TextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/bold_text" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>