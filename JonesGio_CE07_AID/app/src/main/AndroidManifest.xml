<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JonesGio_CE07_AID">

        <activity
            android:name="com.example.jonesgio_ce07_aid.FormActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.fullsail.android.jav2ce08.ACTION_ADD_PERSON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.jonesgio_ce07_aid.DetailsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.fullsail.android.jav2ce08.ACTION_VIEW_PERSON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>